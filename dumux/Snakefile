import json
import os
from pathlib import Path

# Use workflow.basedir to find the root relative to the Snakefile
shared_dir = Path(workflow.basedir).parent
container_image = f"ghcr.io/simulation-benchmarks/dumux-rotating-cylinders:{config.get('software_version', '3.9')}"
container_shared_dir = "/dumux/shared"

rule all:
    input:
        "solution_metrics.json",
        "test_rotatingcylinders.zip"

rule run_simulation:
    input:
        rc_parameters_file = "parameters.json"
    output:
        zip = "test_rotatingcylinders.zip",
        metrics = "solution_metrics.json"
    resources:
        serial_run=1
    singularity:
        f"docker://{container_image}"
    run:
        # Read parameters from the local JSON
        with open(input.rc_parameters_file, 'r') as f:
            data = json.load(f)

        conf_name = data['configuration']
        r1, r2 = data['inner_radius[m]'], data['outer_radius[m]']
        c_radial = data['cells_radial']
        c_angular = data['cells_angular']
        grading = data['mesh_grading']
        omega1 = data['angular_velocity_inner_cylinder[rad/s]']
        omega2 = data['angular_velocity_outer_cylinder[rad/s]']

        midpoint = 0.5 * (r1 + r2)
        half_radial = int(c_radial / 2)

        shell(
            f"""
            set -euo pipefail
            cd /dumux/rotating-cylinders/build-cmake/test/freeflow/navierstokes/rotatingcylinders
            
            # >>> TEMPORARY DIAGNOSTICS (to be removed) >>>
            echo "DIAG cpu: $(grep -m1 'model name' /proc/cpuinfo) / $(nproc) cores / flags avx512f: $(grep -c avx512f /proc/cpuinfo)"
            for variant in "default:" "1thread:OPENBLAS_NUM_THREADS=1" "haswell:OPENBLAS_CORETYPE=Haswell" "haswell1thread:OPENBLAS_CORETYPE=Haswell OPENBLAS_NUM_THREADS=1"; do
                name=$(echo "$variant" | cut -d: -f1); vars=$(echo "$variant" | cut -d: -f2-)
                env $vars OPENBLAS_VERBOSE=2 ./test_ff_navierstokes_rotatingcylinders                     -Grid.Cells0 "{half_radial} {half_radial}" -Grid.Cells1 "{c_angular}"                     -Grid.Grading0 "{grading} -{grading}" -Grid.Radial0 "{r1} {midpoint} {r2}"                     -Problem.Omega1 "{omega1}" -Problem.Omega2 "{omega2}"                     -Problem.Name "/tmp/diag_$name" > "/tmp/diag_$name.log" 2>&1 && rc=ok || rc=FAILED
                echo "DIAG $name: $rc | $(grep -m1 -i 'core:' /tmp/diag_$name.log) | $(grep -m1 'Condition number' /tmp/diag_$name.log)"
            done
            # <<< TEMPORARY DIAGNOSTICS <<<

            # Run simulation. We use the container_shared_dir mount point to save results back to the host
            ./test_ff_navierstokes_rotatingcylinders \
                -Grid.Cells0 "{half_radial} {half_radial}" \
                -Grid.Cells1 "{c_angular}" \
                -Grid.Grading0 "{grading} -{grading}" \
                -Grid.Radial0 "{r1} {midpoint} {r2}" \
                -Problem.Omega1 "{omega1}" \
                -Problem.Omega2 "{omega2}" \
                -Problem.Name "{container_shared_dir}/results/{conf_name}/test_rotatingcylinders"
            """
        )
