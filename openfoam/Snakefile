import json
from pathlib import Path

with open("parameters.json") as f:
    parameters = json.load(f)

_SNAKEFILE_DIR = Path(workflow.snakefile).resolve().parent
tool_version = str(config.get("tool_version", "2412"))

rule all:
    input: "solution_metrics.json"

rule run_simulation_container:
    input:
        template="system/blockMeshDict.template"
    output:
        directory("10000"),
        "log.simpleFoam"
    params:
        r0 = parameters['inner_radius[m]'],
        r1 = parameters['outer_radius[m]'],
        nr = parameters['cells_radial'],
        ntheta = parameters['cells_angular'] // 4,
        g = parameters['mesh_grading'],
        omega = parameters['angular_velocity_inner_cylinder[rad/s]']
    resources:
        serial_run=1
    container: f"docker://opencfd/openfoam-run:{tool_version}"
    shell:
        """
        set -euo pipefail

        sed -e "s/{{r0}}/{params.r0}/g" \
            -e "s/{{r1}}/{params.r1}/g" \
            -e "s/{{nr}}/{params.nr}/g" \
            -e "s/{{ntheta}}/{params.ntheta}/g" \
            -e "s/{{g}}/{params.g}/g" \
            {input.template} > system/blockMeshDict
        sed -i "s/{{omega}}/{params.omega}/g" constant/MRFProperties

        set +u && source /usr/lib/openfoam/openfoam{tool_version}/etc/bashrc && set -u
        chmod +x Allrun
        ./Allrun

        ls -la
        tail log.simpleFoam
        """

rule compute_l2_error:
    input:
        sim_done="log.simpleFoam",
        script=ancient("compute_l2_error.py")
    output:
        "solution_metrics.json"
    shell:
        "python3 {input.script} --single-case ."
